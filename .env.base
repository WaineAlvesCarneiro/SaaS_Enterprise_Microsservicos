# D:\Projetos\SaaS_Enterprise_Microsservicos\.env.base

DOCKER_NETWORK=infra_net

HOST_PORT=8083
CONTAINER_PORT=8083

# SQL connection details
SQL_SERVER=localhost
SQL_CONTAINER=sqlserver2022
SQL_VOLUME=sqlserver_data
SQL_PORT=1433
SQL_SA_USER=sa

# Application JWT
APP_JWT_ISSUER=SaaS_Enterprise_Microsservicos.API
APP_JWT_AUDIENCE=SaaS_Enterprise_Microsservicos.API
APP_JWT_EXPIREMINUTES=15

# RabbitMQ
RABBIT_CONTAINER=rabbitmq
RABBIT_VOLUME=rabbitmq_data
SPRING_RABBITMQ_HOST=rabbitmq
RABBIT_PORT=5672
SPRING_RABBITMQ_USERNAME=admin_geral

QUEUE_EMAILS=fila_emails
EXCHANGE_EMAILS=email_exchange
DLX_EXCHANGE=dlx_exchange
DLX_QUEUE=fila_emails_erro